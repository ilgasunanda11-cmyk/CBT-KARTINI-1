# KARTINI CBT 4.0 Environment Variables
PORT=3000
NODE_ENV=development

# Session & Cookie Security (Set a strong random secret in production)
SESSION_SECRET="change-this-to-a-long-random-secret-in-production"

# SQLite Database Path (Optional override, defaults to ./server/database/kartini_cbt.db)
DATABASE_PATH="./server/database/kartini_cbt.db"

# Media Upload Limits (in bytes)
MAX_IMAGE_SIZE_BYTES=10485760
MAX_AUDIO_SIZE_BYTES=26214400

# Optional CLI Initial Admin Password (only used by scripts/seed.ts if provided)
ADMIN_INIT_USERNAME=""
ADMIN_INIT_PASSWORD=""
